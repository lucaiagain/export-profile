# Export Profile IAGAIN – variabili d'ambiente (copiare in .env.local per lo sviluppo, su Vercel per la produzione).
# Senza SUPABASE_URL, in sviluppo i dati vanno in .data/dev-db.json e le email in .data/mail/.

SITE_URL=https://exportprofile.iagain.it
# versione dell'informativa privacy registrata con il consenso
PRIVACY_VERSION=2026-10-31

# Supabase (progetto dedicato, separato da M.IA)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cifratura dei token dei link personali: 32 byte in base64 (openssl rand -base64 32)
TOKEN_ENC_KEY=

# Questionari non completati
REMINDER_DAYS=2,5,10
RETENTION_DAYS=14

# Email (promemoria, PDF) via SMTP di Aruba, con le credenziali della casella mittente
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=exportprofile@iagain.it
SMTP_PASS=
MAIL_FROM=exportprofile@iagain.it
MAIL_FROM_NAME=IAGAIN Export Profile
# facoltativo: dove arrivano le risposte (es. una casella Microsoft 365)
MAIL_REPLY_TO=

# Brevo: solo contatti/CRM (disattivato finché non arriva la chiave)
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_LIST_ID=

# Invio a M.IA (da attivare quando M.IA avrà l'endpoint)
MIA_ENABLED=false
MIA_ENDPOINT=
MIA_HMAC_SECRET=

# Cloudflare Turnstile (anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_PER_HOUR=10

# Vercel Cron (Vercel lo invia come "Authorization: Bearer ...")
CRON_SECRET=

STAFF_EMAIL_DOMAIN=iagain.it
